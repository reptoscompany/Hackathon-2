# Copy to .env.local and add your key (never commit .env.local):
# VITE_GOOGLE_MAPS_API_KEY=AIza...your_key_here
#
# Google Cloud setup (one time):
# 1. console.cloud.google.com -> New project -> Enable "Maps JavaScript API"
# 2. Credentials -> Create API key -> restrict to your domain/localhost
# 3. Billing must be enabled (Google requires it, free tier covers hackathon use)
VITE_GOOGLE_MAPS_API_KEY=
